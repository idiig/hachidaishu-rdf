    dcterms:identifier "410" ;
    dcterms:creator person:在原業平 ;
    waka:headnote "あつまの方へ友とする人ひとりふたりいさなひていきけり、みかはのくにやつはしといふ所にいたれりけるに、その河のほとりにかきつはたいとおもしろくさけりけるを見て、木のかけにおりゐて、かきつはたといふいつもしをくのかしらにすゑてたひの心をよまむとてよめる"@ja ;
    waka:ku "からころも"@ja ;
    waka:ku "きつつなれにし"@ja ;
    waka:ku "つましあれは"@ja ;
    waka:ku "はるはるきぬる"@ja ;
    waka:ku "たひをしそおもふ"@ja ;
