# --- 歌題 (poem-topic) scheme, for waka:Waka's dcterms:subject ---
# Not from idiig/wlsph -- unrelated source, still to be identified. No
# concrete concept instances yet (no confirmed source poem to ground an
# example in), just the empty scheme declaration so waka-ontology.ttl's
# documentation has somewhere real to point at.
scheme:歌題 a skos:ConceptScheme ;
    dcterms:title "歌題"@ja .

# --- 官位 (court rank/office) scheme, for waka:courtRank (see
# author-ontology.ttl) ---
# Also not from idiig/wlsph or any other found external source (searched
# 2026-08-08, nothing found for Heian court ranks/offices) -- built from
# scratch, only as far as the one concept actually used in
# author-example.ttl. See author-ontology.ttl's comment on this property
# for the unresolved 位階/官職 distinction this scheme doesn't yet make.
scheme:官位 a skos:ConceptScheme ;
    dcterms:title "官位"@ja .

concept:官位-中納言 a skos:Concept ;
    skos:inScheme scheme:官位 ;
    skos:prefLabel "中納言"@ja .

# --- 宗教状態 (religious status) scheme, for waka:religiousStatus ---
scheme:宗教状態 a skos:ConceptScheme ;
    dcterms:title "宗教状態"@ja .

concept:宗教状態-出家 a skos:Concept ;
    skos:inScheme scheme:宗教状態 ;
    skos:prefLabel "出家"@ja .

# 俗 (layperson, i.e. NOT ordained) -- the complement of 出家, needed for
# the anonymous-author 3x3 gender x religious-status placeholder matrix
# in author-example.ttl.
concept:宗教状態-俗 a skos:Concept ;
    skos:inScheme scheme:宗教状態 ;
    skos:prefLabel "俗"@ja .
