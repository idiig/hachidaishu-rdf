    skos:prefLabel "羈旅"@ja .

topic:物名 a skos:Concept ;
    skos:inScheme scheme:部立 ;
    skos:prefLabel "物名"@ja .

topic:恋一 a skos:Concept ;
    skos:inScheme scheme:部立 ;
